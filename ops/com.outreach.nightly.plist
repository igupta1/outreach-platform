<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.outreach.nightly</string>
  <key>ProgramArguments</key>
  <array><string>/bin/zsh</string><string>/Users/ishaangupta/Developer/outreach-platform/ops/nightly.sh</string></array>
  <!-- 02:00 builds; 04:00 and 06:00 retry a failed night (nightly.RUN_HOURS) -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>RunAtLoad</key><false/>
  <!-- not the default background throttling: the batch is the job -->
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>/Users/ishaangupta/Developer/outreach-platform/logs/launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/ishaangupta/Developer/outreach-platform/logs/launchd.log</string>
</dict>
</plist>
