# System B — outreach copy generator. Template. Copy to system_b/.env and fill in.
# (system_b/.env is gitignored; this template is safe to commit.)

# OpenAI (ChatGPT) — research + copy steps. REQUIRED.
OPENAI_API_KEY=

# --- Lead inventory (the gift companies) ---
# The lead inventory (~/Developer/Inventory) writes one JSON per lead type:
#   cd ~/Developer/Inventory && .venv/bin/python -m leadinv.run publish
# Point this at the folder it writes (python -m system_b.morning does so itself):
LEADGEN_INVENTORY_DIR=/absolute/path/to/Inventory/exports/magnets

# LEGACY: the retired lead platform's public Vercel Blob. Leave EMPTY: when set
# it takes precedence over LEADGEN_INVENTORY_DIR (and its taxonomy over the
# vendored one).
LEADGEN_BLOB_BASE_URL=

# FRESHNESS GUARD (optional): refuse to generate against inventory older than
# this many days (default: each magnet's own limit, 45 days for the inventory's
# files); bypass with LEADGEN_ALLOW_STALE=1.
# LEADGEN_MAX_INVENTORY_AGE_DAYS=45
# LEADGEN_ALLOW_STALE=
