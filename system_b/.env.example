# System B — outreach copy generator. Template. Copy to system_b/.env and fill in.
# (system_b/.env is gitignored; this template is safe to commit.)

# OpenAI (ChatGPT) — research + copy steps. REQUIRED.
OPENAI_API_KEY=

# --- Lead inventory (the gift companies) ---
# PRIMARY: the lead platform publishes each <niche>-leads.json (+ taxonomy.json)
# to a PUBLIC Vercel Blob every night. Set this to the public blob base the
# leadgen CI "Publish inventory to Vercel Blob" step prints
# (e.g. https://<store>.public.blob.vercel-storage.com). Public reads need NO
# token. When set, it takes precedence over LEADGEN_INVENTORY_DIR.
LEADGEN_BLOB_BASE_URL=

# OFFLINE FALLBACK (optional, set as a shell env var — only used when
# LEADGEN_BLOB_BASE_URL is unset): a local folder of leadgen JSON.
# LEADGEN_INVENTORY_DIR=/absolute/path/to/lead-platform/leadgen/data

# FRESHNESS GUARD (optional): refuse to generate against inventory older than
# this many days (default 3); bypass with LEADGEN_ALLOW_STALE=1.
# LEADGEN_MAX_INVENTORY_AGE_DAYS=3
# LEADGEN_ALLOW_STALE=
