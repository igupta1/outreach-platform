# System B — outreach copy generator. Template. Copy to system_b/.env and fill in.
# (system_b/.env is gitignored; this template is safe to commit.)

# OpenAI (ChatGPT) — research + copy steps. Required.
OPENAI_API_KEY=

# Lead inventory source. Leave blank to read the live per-niche endpoint at
# SCRAPER_BASE_URL; or set LEADGEN_INVENTORY_DIR (env, not here) to a folder of
# leadgen JSON to run fully offline.
SCRAPER_BASE_URL=
